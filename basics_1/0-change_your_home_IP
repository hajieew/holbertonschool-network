#!/usr/bin/env bash
# This script configures /etc/hosts so that localhost resolves to 127.0.0.2 and facebook.com resolves to 8.8.8.8.

# Remove existing localhost and facebook entries, then append the new ones safely
sudo grep -v -E "localhost|facebook\.com" /etc/hosts | sudo tee /etc/hosts > /dev/null

echo "127.0.0.2 localhost" | sudo tee -a /etc/hosts > /dev/null
echo "8.8.8.8 facebook.com" | sudo tee -a /etc/hosts > /dev/null